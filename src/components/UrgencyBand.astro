---
import { getLocaleFromUrl, t } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
---

<section class="py-14 bg-navy">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-heading text-2xl lg:text-3xl font-bold text-white mb-4">
      {t(locale, 'home.urgency.title')}
    </h2>
    <p class="text-white/70 leading-relaxed mb-8">
      {t(locale, 'home.urgency.text')}
    </p>

    <div class="border-t border-white/10 pt-8 grid md:grid-cols-2 gap-8 items-center text-left">
      <p class="text-white/80 leading-relaxed">
        {t(locale, 'home.urgency.stat')}
      </p>

      <!-- Adoption gap chart -->
      <div class="bg-white/5 rounded-2xl p-6" data-animate>
        <p class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-5">
          {t(locale, 'home.urgency.chartLabel')}
        </p>
        <div class="space-y-4">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-medium text-white">{t(locale, 'home.urgency.chartUS')}</span>
              <span class="text-sm font-bold text-primary-light">43%</span>
            </div>
            <div class="h-3 bg-white/10 rounded-full overflow-hidden">
              <div class="h-full bg-primary rounded-full" style="width: 86%"></div>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-medium text-white">{t(locale, 'home.urgency.chartEU')}</span>
              <span class="text-sm font-bold text-white/60">32%</span>
            </div>
            <div class="h-3 bg-white/10 rounded-full overflow-hidden">
              <div class="h-full bg-white/40 rounded-full" style="width: 64%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="text-xs text-white/40 mt-6 text-left">
      {t(locale, 'home.urgency.source')}
    </p>
  </div>
</section>
