---
import Layout from '../../../layouts/Layout.astro';
import { t } from '../../../i18n/utils';

const articles = [
  {
    href: '/ro/blog/ghid-eu-ai-act-obligatii-firme/',
    title: 'EU AI Act pe scurt: ce obligații are firma ta și de când',
    description:
      'Calendarul complet după amânarea Digital Omnibus, cele patru niveluri de risc, cei cinci pași de conformare pentru o firmă care doar folosește AI și sancțiunile aplicabile.',
    date: '2026-07-29',
    tag: 'EU AI Act',
  },
  {
    href: '/ro/blog/cine-verifica-ai-ul-cumparat-de-stat/',
    title: 'Cine verifică AI-ul pe care îl cumpără statul?',
    description:
      'Instituțiile publice cumpără deja soluții „cu AI”, dar le evaluează cu criterii scrise pentru software clasic. Obligațiile implementatorilor, stadiul autorităților din România și ce poate face o autoritate contractantă acum.',
    date: '2026-07-27',
    tag: 'Achiziții publice',
  },
  {
    href: '/ro/blog/iso-42001-pregatire-eu-ai-act/',
    title: 'ISO/IEC 42001 și EU AI Act: cum îți construiești guvernanța AI înainte de termenele legale',
    description:
      'Ce este standardul, cum se mapează pe obligațiile AI Act pentru sisteme high-risk, cele 38 de controale din Anexa A pe categorii și ce nu rezolvă certificarea.',
    date: '2026-07-09',
    tag: 'Guvernanță AI',
  },
  {
    href: '/ro/blog/ghid-eudr-importatori/',
    title: 'EUDR: ghid pentru importatori — ce obligații ai și cum te pregătești până la 30 decembrie 2026',
    description:
      'Cine este vizat, cele trei interdicții, obligațiile de due diligence (Art. 9–11), geolocația parcelelor, DDS în TRACES și checklistul de pregătire.',
    date: '2026-07-09',
    tag: 'EUDR',
  },
  {
    href: '/ro/blog/ghid-cbam-2026-importatori/',
    title: 'CBAM în 2026: ghid practic pentru importatori — regim definitiv, termene și costuri',
    description:
      'Regimul definitiv a început la 1 ianuarie 2026. Pragul de 50 t, autorizarea ca declarant, calculul emisiilor, certificatele și capcanele frecvente.',
    date: '2026-07-09',
    tag: 'CBAM',
  },
];

const locale = 'ro';
const fmt = (d: string) =>
  new Date(`${d}T12:00:00`).toLocaleDateString('ro-RO', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title="Blog — ghiduri CBAM, EUDR și adoptare AI"
  description="Ghiduri practice despre CBAM, EUDR și adoptarea AI în procese reglementate. Fără hype — doar ce trebuie să știi și ce ai de făcut."
>
  <section class="pt-28 pb-12 lg:pt-36 lg:pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-primary/10 text-primary text-sm font-medium rounded-full mb-6">
        {t(locale, 'blog.eyebrow')}
      </span>
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-navy leading-tight mb-6">
        {t(locale, 'blog.title')}
      </h1>
      <p class="text-lg text-text-light leading-relaxed max-w-2xl mx-auto">
        {t(locale, 'blog.sub')}
      </p>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {articles.map(a => (
        <a href={a.href} class="block bg-surface rounded-2xl p-7 lg:p-8 hover:shadow-lg transition-shadow group">
          <div class="flex items-center gap-3 mb-3 text-sm">
            <span class="px-3 py-0.5 bg-primary/10 text-primary font-medium rounded-full">{a.tag}</span>
            <time datetime={a.date} class="text-text-light">{fmt(a.date)}</time>
          </div>
          <h2 class="font-heading text-xl lg:text-2xl font-bold text-navy leading-snug mb-3 group-hover:text-primary transition-colors">
            {a.title}
          </h2>
          <p class="text-text-light leading-relaxed mb-4">{a.description}</p>
          <span class="text-primary font-medium">{t(locale, 'blog.readMore')} →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
