---
import { getLocaleFromUrl, t, getConsultingServices } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const services = getConsultingServices(locale);
---

<div class="hidden lg:block max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-14">
  <div class="bg-surface rounded-2xl border border-gray-100 p-6">
    <div class="flex items-stretch gap-2">
      {services.map((service, i) => (
        <>
          <a href={service.href} class="flex-1 flex flex-col items-center gap-2 p-4 bg-white rounded-xl border border-gray-50 shadow-sm hover:border-primary/40 hover:shadow-md transition-all text-center" data-animate data-animate-delay={String(i + 1)}>
            <span class="w-8 h-8 bg-primary/10 text-primary rounded-lg flex items-center justify-center text-sm font-bold">{i + 1}</span>
            <span class="text-sm font-medium text-navy leading-snug">{t(locale, service.titleKey)}</span>
          </a>
          {i < services.length - 1 && (
            <svg class="w-5 h-5 text-gray-300 self-center flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          )}
        </>
      ))}
    </div>
  </div>
</div>
