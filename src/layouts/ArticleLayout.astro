---
import Layout from './Layout.astro';
import CTAFinal from '../components/CTAFinal.astro';
import { getLocaleFromUrl, t, getLocalizedPath } from '../i18n/utils';

/** A plain string, or a labelled link to the source. */
type Source = string | { text: string; url: string };

interface Props {
  title: string;
  description: string;
  altPath: string;
  heroTitle: string;
  /** ISO date, e.g. 2026-07-09 */
  publishDate: string;
  /** Site-absolute path to the article illustration, e.g. /images/blog/foo.svg */
  heroImage?: string;
  heroImageAlt?: string;
  faq?: { q: string; a: string }[];
  sources?: Source[];
}

const {
  title,
  description,
  altPath,
  heroTitle,
  publishDate,
  heroImage,
  heroImageAlt = '',
  faq = [],
  sources = [],
} = Astro.props;
const locale = getLocaleFromUrl(Astro.url);

const site = Astro.site ?? new URL('https://www.speed-flow.ai');
const selfUrl = new URL(Astro.url.pathname, site).href;
const blogUrl = new URL(getLocalizedPath(locale, '/blog/'), site).href;
const dateLabel = new Date(`${publishDate}T12:00:00`).toLocaleDateString(locale === 'ro' ? 'ro-RO' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: heroTitle,
    description,
    url: selfUrl,
    mainEntityOfPage: selfUrl,
    datePublished: publishDate,
    dateModified: publishDate,
    inLanguage: locale,
    ...(heroImage ? { image: new URL(heroImage, site).href } : {}),
    author: { '@type': 'Person', name: 'Roxana Voicu' },
    publisher: { '@id': `${site.origin}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Speed Flow', item: new URL(`/${locale}/`, site).href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
      { '@type': 'ListItem', position: 3, name: heroTitle, item: selfUrl },
    ],
  },
];

if (faq.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(item => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---

<Layout title={title} description={description} altPath={altPath} schemas={schemas}>
  <!-- Hero -->
  <section class="pt-28 pb-12 lg:pt-36 lg:pb-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href={getLocalizedPath(locale, '/blog/')} class="inline-block text-sm text-primary font-medium mb-6 hover:underline">
        ← {t(locale, 'blog.back')}
      </a>
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-[2.6rem] font-bold text-navy leading-tight mb-5">
        {heroTitle}
      </h1>
      <p class="text-sm text-text-light">
        {t(locale, 'blog.published')}: <time datetime={publishDate}>{dateLabel}</time>
        &nbsp;·&nbsp; {t(locale, 'blog.author')} Roxana Voicu
      </p>
    </div>
  </section>

  {heroImage && (
    <section class="pb-10">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <img
          src={heroImage}
          alt={heroImageAlt}
          width="1200"
          height="600"
          loading="eager"
          decoding="async"
          class="w-full h-auto rounded-2xl"
        />
      </div>
    </section>
  )}

  <!-- Body -->
  <section class="pb-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="article-body">
        <slot />
      </div>
    </div>
  </section>

  {faq.length > 0 && (
    <section class="py-16 bg-surface">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-2xl lg:text-3xl font-bold text-navy mb-8">
          {t(locale, 'blog.faqTitle')}
        </h2>
        <div class="space-y-6">
          {faq.map(item => (
            <div class="bg-white rounded-xl p-6">
              <h3 class="font-heading font-semibold text-navy mb-2">{item.q}</h3>
              <p class="text-text-light leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {sources.length > 0 && (
    <section class="py-12">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-xl font-bold text-navy mb-4">
          {t(locale, 'blog.sourcesTitle')}
        </h2>
        <ul class="list-disc pl-5 space-y-1.5 text-sm text-text-light">
          {sources.map(s => (
            <li>
              {typeof s === 'string' ? s : (
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2 hover:text-primary-dark">
                  {s.text}
                </a>
              )}
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-text-light italic">
          {t(locale, 'blog.disclaimer')}
        </p>
      </div>
    </section>
  )}

  <CTAFinal />
</Layout>

<style>
  .article-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-navy);
    margin: 2.5rem 0 1rem;
  }
  .article-body :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-navy);
    margin: 2rem 0 0.75rem;
  }
  .article-body :global(p) {
    color: var(--color-text);
    line-height: 1.75;
    margin-bottom: 1.1rem;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 1.25rem;
    padding-left: 1.4rem;
  }
  .article-body :global(ul) { list-style: disc; }
  .article-body :global(ol) { list-style: decimal; }
  .article-body :global(li) { margin-bottom: 0.45rem; }
  .article-body :global(li)::marker { color: var(--color-primary); }
  .article-body :global(strong) { color: var(--color-text-dark); font-weight: 600; }
  .article-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-body :global(a:hover) { color: var(--color-primary-dark); }
  .article-body :global(.table-wrap) {
    overflow-x: auto;
    margin: 0 0 1.5rem;
    border: 1px solid var(--color-surface-dark);
    border-radius: 0.75rem;
  }
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.925rem;
  }
  .article-body :global(th) {
    background: var(--color-surface);
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-weight: 600;
    text-align: left;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-surface-dark);
  }
  .article-body :global(td) {
    color: var(--color-text);
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--color-surface-dark);
    vertical-align: top;
  }
  .article-body :global(tr:last-child td) { border-bottom: none; }
  .article-body :global(.callout) {
    background: var(--color-surface);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 0.75rem 0.75rem 0;
    padding: 1.1rem 1.3rem;
    margin: 0 0 1.5rem;
  }
  .article-body :global(.callout p) { margin: 0; }
  .article-body :global(.callout p + p) { margin-top: 0.6rem; }
</style>
