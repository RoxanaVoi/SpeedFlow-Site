---
import SolutionLayout from '../../../layouts/SolutionLayout.astro';
---

<SolutionLayout
  title="EUDR - Compliance and traceability"
  altPath="/solutii/eudr"
  description="Support for EUDR processes, document traceability and organizing compliance data."
  heroTitle="Support for EUDR compliance"
  heroProblem="The EUDR regulation requires supply chain traceability and complex documentation for targeted products."
  heroResult="We organize data, documents and traceability needed for EUDR compliance."
  forWhom="Companies importing or trading products subject to EUDR that need documented traceability."
  forWhomItems={[
    "Importers of wood, rubber, coffee, cocoa, soy, palm oil, cattle",
    "Companies with complex supply chains",
    "Compliance and sustainability departments",
    "Operators and traders subject to EUDR",
  ]}
  processes={[
    "Supply chain and supplier mapping",
    "Plot geolocation (polygon/point), with protected-area and supplier-overlap checks",
    "AI-assisted extraction of data and GPS coordinates from documents, with manual validation",
    "Automated risk scoring by country, supplier, commodity and documentation",
    "Traceability document collection and organization",
    "Compliance validation per lot/delivery",
    "Due diligence statement generation and TRACES export",
    "Data monitoring and updates, including monthly supplier sanctions rescreening",
  ]}
  howItWorks={[
    { title: "Supplier mapping", desc: "We identify and structure information about suppliers and product origins." },
    { title: "Document collection", desc: "We centralize traceability documents, certificates and declarations." },
    { title: "Compliance validation", desc: "We verify completeness and correctness of documentation for each lot." },
    { title: "Report generation", desc: "We prepare declarations and reports required by authorities." },
  ]}
  outputs={[
    "Structured traceability registry, with an interactive plot map",
    "Per-lot risk score, aligned with the Art. 10(2) conclusion — negligible/non-negligible",
    "Due diligence declarations, with validated XML export and TRACES integration",
    "Per-supplier compliance status dashboard",
    "Alerts for missing or expired documents, and for supplier sanctions",
  ]}
  faq={[
    { q: "What products are targeted?", a: "Wood, rubber, coffee, cocoa, soy, palm oil and cattle, including derived products." },
    { q: "When does EUDR take effect?", a: "The regulation applies to large and medium operators from December 30, 2026, and to micro and small enterprises from June 30, 2027." },
    { q: "How is risk calculated?", a: "Through an automated scoring engine across 4 components (country, supplier, commodity, documentation), with automatic blocking rules for high-risk cases or missing documentation." },
    { q: "Is a demo available?", a: "Yes. You can open the demo directly from this page or contact us for a guided tour." },
  ]}
  demoAvailable={true}
  demoLabel="Demo available"
  demoUrl="https://app.speed-flow.ai/login"
  serviceSchema={{
    name: "EUDR Manager — EUDR compliance and traceability",
    description: "Platform and consulting for EUDR compliance: collecting supplier geolocations, risk assessment and generating due diligence declarations.",
  }}
  guideLinks={[
    { href: "/en/blog/eudr-guide-importers/", label: "Not sure if EUDR affects you? Read the full guide for importers →" },
  ]}
/>
