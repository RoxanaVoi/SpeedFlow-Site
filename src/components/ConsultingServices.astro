---
import { getLocaleFromUrl, t, getConsultingServices } from '../i18n/utils';

interface Props {
  showHeading?: boolean;
}

const { showHeading = true } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const services = getConsultingServices(locale);

const icons: Record<string, string> = {
  diagnostic: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  dataPrep: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4',
  governance: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  agents: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  adoption: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
};
---

<section class="py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {showHeading && (
      <div class="max-w-3xl mx-auto text-center mb-14">
        <h2 class="font-heading text-3xl lg:text-4xl font-bold text-navy mb-4">
          {t(locale, 'home.method.title')}
        </h2>
        <p class="text-lg text-text-light leading-relaxed">
          {t(locale, 'home.method.intro')}
        </p>
      </div>
    )}

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <a href={service.href} class="group flex flex-col p-6 bg-white rounded-2xl border border-gray-100 hover:shadow-lg transition-all duration-300" data-animate data-animate-delay={String((i % 4) + 1)}>
          <div class="flex items-center justify-between mb-4">
            <div class="w-11 h-11 bg-primary/10 rounded-xl flex items-center justify-center">
              <svg class="w-5.5 h-5.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={icons[service.key]}/>
              </svg>
            </div>
            <span class="font-heading text-sm font-bold text-text-light/50">0{i + 1}</span>
          </div>
          <h3 class="font-heading text-lg font-bold text-navy mb-2 group-hover:text-primary transition-colors">
            {t(locale, service.titleKey)}
          </h3>
          <p class="text-sm text-text-light leading-relaxed mb-4 flex-1">
            {t(locale, service.shortKey)}
          </p>
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-primary">
            {t(locale, 'services.learnMore')}
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
