import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const faq = [
  {
    q: 'De când se aplică efectiv EUDR?',
    a: 'Obligațiile principale se aplică de la 30 decembrie 2026 pentru operatorii mari și mijlocii și de la 30 iunie 2027 pentru microîntreprinderile și întreprinderile mici (care aveau acest statut la 31 decembrie 2024). Micro și micii operatori care erau deja acoperiți de EUTR pentru lemn intră tot de la 30 decembrie 2026.',
  },
  {
    q: 'Ce produse intră sub EUDR?',
    a: 'Produsele legate de șapte mărfuri: bovine, cacao, cafea, palmier de ulei, cauciuc, soia și lemn. Încadrarea se decide după codul NC din Anexa I a regulamentului — de exemplu lemn și produse derivate (cap. 44), hârtie și carton (cap. 48), mobilă (cap. 94). Nu există prag de minimis: orice cantitate intră în domeniu.',
  },
  {
    q: 'Ce este Declarația de Diligență (DDS)?',
    a: 'DDS este declarația depusă în sistemul de informații EUDR (accesat prin platforma TRACES) prin care operatorul confirmă că a exercitat due diligence și că riscul de neconformitate este neglijabil. Ea generează un număr de referință care se atașează declarației vamale — fără el, importul nu poate fi procesat.',
  },
  {
    q: 'Ce înseamnă cerința de geolocație?',
    a: 'Pentru fiecare parcelă de origine trebuie furnizate coordonate de latitudine și longitudine cu minimum 6 zecimale. Parcelele mai mari de 4 hectare (cu excepția bovinelor) trebuie descrise ca poligoane, nu ca punct unic.',
  },
  {
    q: 'Ce riscă un importator neconform?',
    a: 'Blocarea importurilor în vamă, confiscarea mărfii, amenzi administrative proporționale cu prejudiciul de mediu și valoarea mărfii, excluderea temporară de la achiziții publice și pierderea accesului pe piața UE. Documentația trebuie păstrată 5 ani și prezentată la control.',
  },
  {
    q: 'Vând doar în România, nu export. Scap de EUDR?',
    a: 'Nu. EUDR se aplică introducerii pe piața UE, iar România este piață UE. Dacă imporți produse vizate din afara Uniunii sau le produci și le pui prima dată pe piață, obligațiile se aplică integral, chiar dacă întreaga ta vânzare este internă.',
  },
  {
    q: 'Sunt comerciant, nu importator. Mă privește?',
    a: 'Da, dar cu obligații mult mai ușoare. Nu depui propriile declarații: te înregistrezi în sistem, colectezi numerele de referință ale DDS depuse în amonte, le păstrezi și le prezinți la control. Excepția o reprezintă comercianții mari și mijlocii, care preiau obligații de operator atunci când introduc produsul pe piață sub numele lor.',
  },
  {
    q: 'Furnizorii mei nu au sisteme digitale. Cum colectez datele?',
    a: 'Un flux funcțional și cu furnizori „low-tech" este un formular standard (de exemplu Excel) cu câmpurile obligatorii — date produs, coordonate GPS, documente de legalitate — completat de furnizor și încărcat intern. Important este ca validarea completitudinii și consistenței să fie sistematică, nu manuală.',
  },
