---
import Layout from '../../../layouts/Layout.astro';
import { t } from '../../../i18n/utils';

const articles = [
  {
    href: '/en/blog/compliance-2026-from-files-to-data/',
    title: '2026, the year “we are compliant” stopped meaning anything',
    description:
      'CBAM, EUDR and the AI Act are simultaneously moving the standard from “you filled in the document” to “the information matches reality”. Why perfect files no longer protect you.',
    date: '2026-07-30',
    tag: 'Analysis',
  },
  {
    href: '/en/blog/eu-ai-act-obligations-guide/',
    title: 'The EU AI Act in brief: what your company must do, and by when',
    description:
      'The full timeline after the Digital Omnibus postponement, the four risk levels, the five compliance steps for a company that merely uses AI, and the applicable penalties.',
    date: '2026-07-29',
    tag: 'EU AI Act',
  },
  {
    href: '/en/blog/who-checks-the-ai-the-state-buys/',
    title: 'Who checks the AI the state buys?',
    description:
      'Public institutions are already buying “AI-powered” solutions but evaluate them with criteria written for classic software. Deployer obligations, where Romania stands on national authorities, and what a contracting authority can do now.',
    date: '2026-07-27',
    tag: 'Public procurement',
  },
  {
    href: '/en/blog/iso-42001-eu-ai-act-preparation/',
    title: 'ISO/IEC 42001 and the EU AI Act: building your AI governance before the legal deadlines',
    description:
      'What the standard is, how it maps to the AI Act obligations for high-risk systems, the 38 Annex A controls by category and what certification does not solve.',
    date: '2026-07-09',
    tag: 'AI Governance',
  },
  {
    href: '/en/blog/eudr-guide-importers/',
    title: 'EUDR: a guide for importers — your obligations and how to prepare before 30 December 2026',
    description:
      'Who is in scope, the three prohibitions, due diligence obligations (Art. 9–11), plot geolocation, the DDS in TRACES and the preparation checklist.',
    date: '2026-07-09',
    tag: 'EUDR',
  },
  {
    href: '/en/blog/cbam-guide-2026-importers/',
    title: 'CBAM in 2026: a practical guide for importers — definitive regime, deadlines and costs',
    description:
      'The definitive regime started on 1 January 2026. The 50-tonne threshold, declarant authorisation, emissions calculation, certificates and common pitfalls.',
    date: '2026-07-09',
    tag: 'CBAM',
  },
];

const locale = 'en';
const fmt = (d: string) =>
  new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title="Blog — CBAM, EUDR and AI adoption guides"
  description="Practical guides on CBAM, EUDR and AI adoption in regulated processes. No hype — just what you need to know and what to do."
>
  <section class="pt-28 pb-12 lg:pt-36 lg:pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-primary/10 text-primary text-sm font-medium rounded-full mb-6">
        {t(locale, 'blog.eyebrow')}
      </span>
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-navy leading-tight mb-6">
        {t(locale, 'blog.title')}
      </h1>
      <p class="text-lg text-text-light leading-relaxed max-w-2xl mx-auto">
        {t(locale, 'blog.sub')}
      </p>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {articles.map(a => (
        <a href={a.href} class="block bg-surface rounded-2xl p-7 lg:p-8 hover:shadow-lg transition-shadow group">
          <div class="flex items-center gap-3 mb-3 text-sm">
            <span class="px-3 py-0.5 bg-primary/10 text-primary font-medium rounded-full">{a.tag}</span>
            <time datetime={a.date} class="text-text-light">{fmt(a.date)}</time>
          </div>
          <h2 class="font-heading text-xl lg:text-2xl font-bold text-navy leading-snug mb-3 group-hover:text-primary transition-colors">
            {a.title}
          </h2>
          <p class="text-text-light leading-relaxed mb-4">{a.description}</p>
          <span class="text-primary font-medium">{t(locale, 'blog.readMore')} →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
