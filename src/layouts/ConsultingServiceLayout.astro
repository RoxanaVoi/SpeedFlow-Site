---
import Layout from './Layout.astro';
import CTAFinal from '../components/CTAFinal.astro';
import { getLocaleFromUrl, t } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  altPath: string;
  heroTitle: string;
  positioning: string;
  problem: string[];
  deliverables: string[];
  steps: { title: string; desc: string }[];
  why: string;
  /** Related blog guides, rendered as a callout after the hero. */
  guideLinks?: { href: string; label: string }[];
  /** Visible buyer questions, also emitted as FAQPage structured data. */
  faq?: { q: string; a: string }[];
}

const {
  title, description, altPath, heroTitle, positioning, problem, deliverables, steps, why,
  guideLinks = [], faq = [],
} = Astro.props;
const locale = getLocaleFromUrl(Astro.url);

const site = Astro.site ?? new URL('https://www.speed-flow.ai');
const selfUrl = new URL(Astro.url.pathname, site).href;
const consultingBase = locale === 'ro' ? '/ro/consultanta-ai/' : '/en/ai-consulting/';

const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: heroTitle,
    description,
    url: selfUrl,
    serviceType: locale === 'ro' ? 'Consultanță în adoptarea AI' : 'AI adoption consulting',
    provider: { '@id': `${site.origin}/#organization` },
    areaServed: ['RO', 'EU'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Speed Flow',
        item: new URL(`/${locale}/`, site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(locale, 'nav.consulting'),
        item: new URL(consultingBase, site).href,
      },
      { '@type': 'ListItem', position: 3, name: heroTitle, item: selfUrl },
    ],
  },
];

if (faq.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(item => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---

<Layout title={title} description={description} altPath={altPath} schemas={schemas}>
  <!-- Hero -->
  <section class="pt-28 pb-16 lg:pt-36 lg:pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 bg-primary/10 text-primary text-sm font-medium rounded-full mb-6">
        {t(locale, 'nav.consulting')}
      </span>
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-navy leading-tight mb-6">
        {heroTitle}
      </h1>
      <p class="text-lg text-text-light leading-relaxed max-w-2xl mx-auto">
        {positioning}
      </p>
    </div>
  </section>

  {guideLinks.length > 0 && (
    <section class="pb-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-primary/5 border-l-4 border-primary rounded-r-xl p-5 lg:p-6 space-y-2">
          {guideLinks.map(link => (
            <p class="text-text">
              <a href={link.href} class="text-primary font-medium underline underline-offset-2 hover:text-primary-dark">
                {link.label}
              </a>
            </p>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Problem -->
  <section class="py-16 bg-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl lg:text-3xl font-bold text-navy mb-6">
        {t(locale, 'services.problemTitle')}
      </h2>
      <div class="space-y-4">
        {problem.map(p => (
          <p class="text-text-light leading-relaxed">{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl lg:text-3xl font-bold text-navy mb-8">
        {t(locale, 'services.deliverTitle')}
      </h2>
      <ul class="grid sm:grid-cols-2 gap-4">
        {deliverables.map(item => (
          <li class="flex items-start gap-3 p-4 bg-surface rounded-xl">
            <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-text leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How we work -->
  <section class="py-16 bg-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-2xl lg:text-3xl font-bold text-navy mb-8">
        {t(locale, 'services.howTitle')}
      </h2>
      <div class="space-y-6">
        {steps.map((step, i) => (
          <div class="flex items-start gap-5">
            <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0">
              <span class="text-primary font-bold">{i + 1}</span>
            </div>
            <div>
              <h3 class="font-heading font-semibold text-navy mb-1">{step.title}</h3>
              <p class="text-text-light leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why it matters -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-navy rounded-2xl p-8 lg:p-10">
        <h2 class="font-heading text-2xl font-bold text-white mb-4">
          {t(locale, 'services.whyTitle')}
        </h2>
        <p class="text-white/80 leading-relaxed">{why}</p>
      </div>
    </div>
  </section>

  {faq.length > 0 && (
    <section class="py-16 bg-surface">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-2xl lg:text-3xl font-bold text-navy mb-8">
          {locale === 'ro' ? 'Întrebări frecvente despre guvernanța AI' : 'AI governance frequently asked questions'}
        </h2>
        <div class="space-y-4">
          {faq.map(item => (
            <details class="group bg-white rounded-xl border border-gray-100 overflow-hidden">
              <summary class="flex items-center justify-between p-5 cursor-pointer font-medium text-navy hover:text-primary transition-colors">
                {item.q}
                <svg class="w-5 h-5 text-text-light group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="px-5 pb-5 text-text-light leading-relaxed">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTAFinal />
</Layout>
