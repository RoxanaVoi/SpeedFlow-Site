---
import { getLocaleFromUrl, t } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
---

<section class="py-14 bg-navy">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-heading text-2xl lg:text-3xl font-bold text-white mb-4">
      {t(locale, 'home.urgency.title')}
    </h2>
    <p class="text-white/70 leading-relaxed mb-8">
      {t(locale, 'home.urgency.text')}
    </p>

    <div class="border-t border-white/10 pt-8 grid md:grid-cols-2 gap-8 items-center text-left">
      <p class="text-white/80 leading-relaxed">
        {t(locale, 'home.urgency.stat')}
      </p>

      <!-- Adoption gap chart -->
      <div class="bg-white/5 rounded-2xl p-6" data-animate id="adoption-chart">
        <p class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-5">
          {t(locale, 'home.urgency.chartLabel')}
        </p>
        <div class="space-y-4">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-medium text-white">{t(locale, 'home.urgency.chartUS')}</span>
              <span class="text-sm font-bold text-primary-light" data-countup="43">0%</span>
            </div>
            <div class="h-3 bg-white/10 rounded-full overflow-hidden">
              <div class="h-full bg-primary rounded-full transition-none" data-barwidth="86" style="width: 0%"></div>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-medium text-white">{t(locale, 'home.urgency.chartEU')}</span>
              <span class="text-sm font-bold text-white/60" data-countup="32">0%</span>
            </div>
            <div class="h-3 bg-white/10 rounded-full overflow-hidden">
              <div class="h-full bg-white/40 rounded-full transition-none" data-barwidth="64" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="text-xs text-white/40 mt-6 text-left">
      {t(locale, 'home.urgency.source')}
    </p>
  </div>
</section>

<script>
  const chart = document.getElementById('adoption-chart');
  if (chart) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    const animate = () => {
      const duration = 1100;
      const counters = chart.querySelectorAll<HTMLElement>('[data-countup]');
      const bars = chart.querySelectorAll<HTMLElement>('[data-barwidth]');
      const setProgress = (p: number) => {
        counters.forEach(el => {
          el.textContent = Math.round(p * Number(el.dataset.countup)) + '%';
        });
        bars.forEach(el => {
          el.style.width = (p * Number(el.dataset.barwidth)).toFixed(1) + '%';
        });
      };
      const start = performance.now();
      const tick = (now: number) => {
        const p = easeOut(Math.min((now - start) / duration, 1));
        setProgress(p);
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      // rAF is paused in background tabs — guarantee the final state regardless
      setTimeout(() => setProgress(1), duration + 400);
    };
    const observer = new IntersectionObserver((entries) => {
      if (entries.some(e => e.isIntersecting)) {
        animate();
        observer.disconnect();
      }
    }, { threshold: 0.4 });
    observer.observe(chart);
  }
</script>
