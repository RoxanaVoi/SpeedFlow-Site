---
import { getLocaleFromUrl, t } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const items = [
  { titleKey: 'home.trust.i1.title', descKey: 'home.trust.i1.desc', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { titleKey: 'home.trust.i2.title', descKey: 'home.trust.i2.desc', icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z' },
  { titleKey: 'home.trust.i3.title', descKey: 'home.trust.i3.desc', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];
---

<section class="py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-heading text-3xl lg:text-4xl font-bold text-navy text-center mb-5">
      {t(locale, 'home.trust.title')}
    </h2>
    <p class="text-text-light leading-relaxed text-center max-w-3xl mx-auto mb-14">
      {t(locale, 'home.trust.identity')}
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item, i) => (
        <div class="p-6 bg-surface rounded-2xl border border-gray-100" data-animate data-animate-delay={String((i % 4) + 1)}>
          <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}/>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-navy mb-2">{t(locale, item.titleKey)}</h3>
          <p class="text-sm text-text-light leading-relaxed">{t(locale, item.descKey)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
