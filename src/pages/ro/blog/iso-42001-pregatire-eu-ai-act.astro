const faq = [
  {
    q: 'Ce este un sistem de management al AI (AIMS)?',
    a: 'Un ansamblu de politici, roluri, procese și controale prin care o organizație guvernează dezvoltarea și utilizarea AI: cine decide, cum se evaluează riscurile și impactul, cum se gestionează datele și ciclul de viață al sistemelor, cum se documentează deciziile. ISO/IEC 42001 este standardul internațional care definește cerințele unui astfel de sistem.',
  },
  {
    q: 'Este ISO/IEC 42001 obligatoriu?',
    a: 'Nu. ISO 42001 este un standard voluntar, iar certificarea este o alegere a organizației. EU AI Act, în schimb, este lege și se aplică direct. Standardul este însă cel mai structurat instrument disponibil pentru a construi guvernanța pe care AI Act o presupune.',
  },
  {
    q: 'Certificarea ISO 42001 garantează conformitatea cu EU AI Act?',
    a: 'Nu. Standardul acoperă fundamentul de guvernanță — risc, date, documentație, supraveghere umană — dar AI Act are obligații legale specifice care nu fac parte din niciun standard voluntar: evaluarea de conformitate, înregistrarea în baza de date UE, regulile pentru modelele de uz general (GPAI). Corect este să privești ISO 42001 ca pe o fundație, nu ca pe o scutire.',
  },
  {
    q: 'Cine ar trebui să ia în calcul implementarea?',
    a: 'Orice organizație care dezvoltă sau folosește sisteme AI în procese cu miză: furnizori de sisteme AI (mai ales high-risk), companii care integrează AI în decizii despre oameni (HR, credit, sănătate), instituții publice și organizații din lanțuri de aprovizionare unde clienții încep să ceară dovezi de guvernanță AI.',
  },
  {
    q: 'Care este legătura cu ISO 27001?',
    a: 'ISO 42001 folosește aceeași structură armonizată (clauzele 4–10) ca ISO 27001 și ISO 9001. O organizație certificată deja pe 27001 poate extinde sistemul existent — politici, audit intern, managementul riscului — în loc să construiască de la zero, iar auditurile se pot combina.',
  },
  {
    q: 'De când se aplică obligațiile AI Act pentru sistemele high-risk?',
    a: 'Termenul stabilit inițial este 2 august 2026 pentru sistemele high-risk din Anexa III. În mai 2026 s-a ajuns la un acord provizoriu de amânare a acestui termen până în decembrie 2027, dar până la adoptarea formală, termenul original rămâne în vigoare. Concluzia practică: fereastra de pregătire există, dar nu este un motiv de amânare a guvernanței.',
  },
];

const sources = [
  'ISO/IEC 42001:2023 — Information technology — Artificial intelligence — Management system (iso.org)',
  'Regulamentul (UE) 2024/1689 privind inteligența artificială (EU AI Act)',
