---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  /** Path (without locale prefix) of this page's version in the other locale, when slugs differ. */
  altPath?: string;
  /** Extra JSON-LD structured data objects for this page (Service, FAQPage, SoftwareApplication etc.). */
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description = 'Consultanță în adoptarea AI: diagnostic de procese, pregătirea datelor, guvernanță și agenți în producție.',
  altPath,
  schemas = [],
} = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const otherLocale = locale === 'ro' ? 'en' : 'ro';
const site = Astro.site ?? new URL('https://www.speed-flow.ai');
const ogImage = new URL('/images/og-default.png', site).href;
const currentPath = Astro.url.pathname.replace(new RegExp(`^/${locale}`), '') || '/';
const altUrlPath = `/${otherLocale}${altPath ?? currentPath}`.replace(/\/?$/, '/');
const selfUrl = new URL(Astro.url.pathname, site).href;
const altUrl = new URL(altUrlPath, site).href;
const roUrl = locale === 'ro' ? selfUrl : altUrl;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.origin}/#organization`,
  name: 'Speed Flow',
  legalName: 'Equalys Global',
  url: site.origin + '/',
  logo: new URL('/favicon.svg', site).href,
  image: ogImage,
  email: 'office@speed-flow.ai',
  description:
    locale === 'ro'
      ? 'Consultanță în adoptarea AI: diagnostic de procese, pregătirea datelor, guvernanță și agenți în producție. Soluții pentru procese reglementate: CBAM, EUDR, achiziții publice.'
      : 'AI adoption consulting: process diagnostics, data preparation, governance and agents in production. Solutions for regulated processes: CBAM, EUDR, public procurement.',
  areaServed: ['RO', 'EU'],
  knowsAbout: [
    'AI adoption',
    'AI governance',
    'ISO/IEC 42001',
    'AI agents',
    'data preparation',
    'CBAM',
    'EUDR',
    'public procurement',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.origin}/#website`,
  name: 'Speed Flow',
  url: site.origin + '/',
  inLanguage: ['ro', 'en'],
  publisher: { '@id': `${site.origin}/#organization` },
};

const allSchemas = [orgSchema, webSiteSchema, ...schemas];
---

<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={selfUrl} />
  <link rel="alternate" hreflang={locale} href={selfUrl} />
  <link rel="alternate" hreflang={otherLocale} href={altUrl} />
  <link rel="alternate" hreflang="x-default" href={roUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Speed Flow" />
  <meta property="og:title" content={`${title} | Speed Flow`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={selfUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={locale === 'ro' ? 'ro_RO' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | Speed Flow`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <title>{title} | Speed Flow</title>
  {allSchemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <!-- Google tag (gtag.js) -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=AW-18356650688"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', 'AW-18356650688');
  </script>
</head>
<body class="min-h-screen flex flex-col">
  <Header altUrl={altUrlPath} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />

  <script>
    // Scroll animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          entry.target.classList.remove('hidden-anim');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('[data-animate]').forEach(el => {
      el.classList.add('hidden-anim');
      observer.observe(el);
    });
  </script>
</body>
</html>
