---
import Layout from '../../../layouts/Layout.astro';
import ConsultingFlow from '../../../components/ConsultingFlow.astro';
import ConsultingServices from '../../../components/ConsultingServices.astro';
import WhyAIFails from '../../../components/WhyAIFails.astro';
import TrustCredentials from '../../../components/TrustCredentials.astro';
import CTAFinal from '../../../components/CTAFinal.astro';
import { getLocaleFromUrl, t, getLocalizedPath } from '../../../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const site = Astro.site ?? new URL('https://www.speed-flow.ai');
const selfUrl = new URL(Astro.url.pathname, site).href;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Consultanță AI, strategie și guvernanță',
    description: 'Consultanță pentru strategie AI, guvernanță AI și adoptarea responsabilă a inteligenței artificiale în companii.',
    serviceType: 'Consultanță AI și strategie AI',
    provider: { '@id': `${site.origin}/#organization` },
    areaServed: { '@type': 'Country', name: 'România' },
    url: selfUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Speed Flow', item: new URL('/ro/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Consultanță AI', item: selfUrl },
    ],
  },
];
---

<Layout
  title="Consultanță AI, strategie și guvernanță"
  description="Consultanță AI în România pentru strategie AI, guvernanță, pregătirea datelor și implementarea agenților în procesele companiei."
  altPath="/ai-consulting"
  schemas={schemas}
>
  <!-- Hero -->
  <section class="pt-28 pb-16 lg:pt-36 lg:pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold text-navy leading-tight mb-6">
        {t(locale, 'consulting.h1')}
      </h1>
      <p class="text-lg text-text-light leading-relaxed mb-8 max-w-2xl mx-auto">
        {t(locale, 'consulting.sub')}
      </p>
      <a href={getLocalizedPath(locale, '/contact')} class="inline-block px-7 py-3.5 bg-primary text-white font-semibold rounded-lg hover:bg-primary-light transition-colors">
        {t(locale, 'hero.cta1')}
      </a>
    </div>
    <ConsultingFlow />
  </section>

  <ConsultingServices />
  <WhyAIFails />
  <TrustCredentials />
  <CTAFinal />
</Layout>
