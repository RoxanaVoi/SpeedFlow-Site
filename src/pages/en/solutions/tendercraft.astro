---
import SolutionLayout from '../../../layouts/SolutionLayout.astro';
---

<SolutionLayout
  title="TenderCraft - Bid generation for public procurement"
  description="Bid generation for public procurement procedures - design and/or execution. It extracts the requirements from the documentation and builds the bid."
  altPath="/solutii/tendercraft"
  heroTitle="Bid generation for public procurement"
  heroProblem="Preparing a bid - design and/or execution - means days of reading documentation, extracting requirements and drafting answers, under deadline pressure."
  heroResult="TenderCraft extracts the requirements from the tender documentation and builds the bid on the required structure."
  forWhom="Economic operators participating in public procurement procedures who want to reduce the time and errors in bid preparation."
  forWhomItems={[
    "Construction and design companies",
    "Companies that bid frequently in public tenders",
    "In-house bidding teams",
    "Public procurement consultants",
  ]}
  processes={[
    "Tender documentation import",
    "Requirement extraction and structuring",
    "Bid structure built on the requirements",
    "Technical proposal drafting",
    "Requirement coverage check before submission",
    "Document export in the required format",
  ]}
  howItWorks={[
    { title: "Documentation import", desc: "The tender documentation is imported and analyzed automatically." },
    { title: "Requirement extraction", desc: "Technical and administrative requirements are extracted and structured." },
    { title: "Bid building", desc: "The bid is built on the required structure, with an answer for each requirement." },
    { title: "Check and export", desc: "Requirement coverage is verified before export and submission." },
  ]}
  outputs={[
    "Structured list of requirements from the documentation",
    "Bid structure based on the requirements",
    "Drafted technical proposal",
    "Requirement coverage report",
    "Documents exported for submission",
  ]}
  faq={[
    { q: "What types of procedures does it cover?", a: "Public procurement procedures for design and/or execution, with standard tender documentation." },
    { q: "Does it replace the bidding team?", a: "No. It automates requirement extraction and bid structuring; the decisions and the final content stay with the team." },
    { q: "Is there a demo available?", a: "Yes, a demo is available on request. Contact us and we will schedule a walkthrough on your scenario." },
  ]}
  demoAvailable={true}
  demoLabel="Demo available"
/>
